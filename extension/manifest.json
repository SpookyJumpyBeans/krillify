{
  "manifest_version": 3,
  "name": "Krillify",
  "version": "1.1.1",
  "description": "Reads Puffer Party prompts and suggests three obscure answers without repeating previous suggestions.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://krillion.io/*",
        "https://www.krillion.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Krillify settings",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "102"
}
