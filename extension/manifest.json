{
  "manifest_version": 3,
  "name": "Krillify",
  "version": "1.4.0",
  "description": "Three obscure Puffer Party suggestions, live prompt detection, and used-answer tracking for each game.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://krillion.io/*",
        "https://www.krillion.io/*"
      ],
      "js": [
        "game-events.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://krillion.io/*",
        "https://www.krillion.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Krillify settings",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "111"
}
